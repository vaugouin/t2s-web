# Server-side configuration only. No database credentials are used.
HOST=127.0.0.1
PORT=4180
# Local mounting defaults to /. Docker Compose overrides this to /t2s-web/.
T2S_BASE_PATH=/
# Include any API deployment prefix in the URL. Do not embed credentials in it.
T2S_BLUE_URL=http://127.0.0.1:8000
T2S_BLUE_API_KEY=
# Optional second API deployment.
T2S_GREEN_URL=
T2S_GREEN_API_KEY=
T2S_TIMEOUT_MS=180000
